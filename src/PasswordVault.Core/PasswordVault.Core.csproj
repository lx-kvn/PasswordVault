<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- PasswordVault.exe（獨立宿主，編譯期直接參考）與 FileLocker.App（執行期用
         AssemblyLoadContext 動態載入這個 dll）都消費這個專案的編譯輸出——見
         PasswordVault_獨立化_規劃.md 第 3 節「不對稱的消費關係」。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 不引用 FileLocker repo 的原始碼，只 vendor 這個編譯好的組件檔——見 vendor/README.md
         說明為什麼這裡必須是同一份組件檔（HintPath 參照），不能用重新定義同名介面取代。 -->
    <Reference Include="FileLocker.PluginContracts">
      <HintPath>..\..\vendor\FileLocker.PluginContracts.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- 擴充功能 manifest.json 的簽署金鑰刻意沿用 FileLocker.Extension 時期的舊值（見
         src/PasswordVault.Extension/README.md），擴充功能 ID 因此也不變，這裡直接沿用同一個值，
         不需要每次重新去 chrome://extensions 複製貼上。 -->
    <None Include="extension-id.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

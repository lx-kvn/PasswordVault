<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 專案名稱維持 PasswordVault.App（跟 PasswordVault.Core／PasswordVault.NativeHost 的
         命名慣例一致），但建置出來的執行檔改叫 PasswordVault.exe——比照 FileLocker.App 的既有
         慣例，工作列/工作管理員顯示的檔名更貼近產品名稱。 -->
    <AssemblyName>PasswordVault</AssemblyName>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 系統匣圖示（TrayIconManager 用的 System.Windows.Forms.NotifyIcon）需要——WPF 沒有原生的
         托盤圖示 API，這點跟 FileLocker.App 的既有理由一致。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- UseWindowsForms 會自動幫整個專案加一個隱含的 using System.Windows.Forms，跟 UseWPF 的
       using System.Windows 撞名（Application、KeyEventArgs 兩邊都有同名型別）——跟
       FileLocker.App.csproj 同一個處理方式。 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PasswordVault.Core\PasswordVault.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- App.xaml.cs 直接建構 PasswordLockerPluginContext、PasswordVaultNativePipeServer 需要
         IPasswordLockerPlugin 型別，兩者都來自這份 vendor 的組件檔（見 vendor/README.md）。 -->
    <Reference Include="FileLocker.PluginContracts">
      <HintPath>..\..\vendor\FileLocker.PluginContracts.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <!--
    只有 Release 建置才需要打包前端靜態檔案——Debug 建置照舊連到 Vite 開發伺服器（見
    MainWindow.xaml.cs 的 #if DEBUG 分支），比照 FileLocker.App.csproj 既有的
    BuildWebFrontend/CopyWebAppForRelease/AddWebAppToPublishOutput 三段式做法。
  -->
  <Target Name="BuildWebFrontend" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="npm run build" WorkingDirectory="..\PasswordVault.Web" />
  </Target>

  <Target Name="CopyWebAppForRelease" AfterTargets="BuildWebFrontend" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <WebAppFiles Include="..\PasswordVault.Web\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebAppFiles)" DestinationFolder="$(OutDir)webapp\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="AddWebAppToPublishOutput" BeforeTargets="ComputeFilesToPublish" Condition="'$(Configuration)' == 'Release' AND Exists('..\PasswordVault.Web\dist')">
    <ItemGroup>
      <WebAppFilesForPublish Include="..\PasswordVault.Web\dist\**\*.*" />
      <ResolvedFileToPublish Include="@(WebAppFilesForPublish)">
        <RelativePath>webapp\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
    CLI（PasswordVault.Cli）跟 GUI 是各自獨立的建置產物，比照 FileLocker.App.csproj 的既有做法
    （BuildCli/CopyCliForRelease/AddCliToPublishOutput 三個 Target）：Build 階段先另外
    dotnet build 出 CLI，複製到輸出目錄下的 cli/ 子資料夾，再讓 dotnet publish 也把這個子
    資料夾一起帶走。

    放獨立子資料夾、不是跟 GUI 混在同一層：CLI 自己有一份完整的相依 DLL（PasswordVault.Core.dll
    等），跟 GUI 那份是分開建置出來的兩份拷貝，混在同一個資料夾容易撞名或載到錯的版本。獨立子
    資料夾也剛好搭配安裝程式的 path_target_exe 欄位——加入系統 PATH 的只有 cli/ 這一層。
  -->
  <Target Name="BuildCli" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="dotnet build ..\PasswordVault.Cli\PasswordVault.Cli.csproj -c Release" />
  </Target>

  <Target Name="CopyCliForRelease" AfterTargets="BuildCli" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <CliFiles Include="..\PasswordVault.Cli\bin\Release\net10.0-windows10.0.19041.0\**\*.*"
                Exclude="..\PasswordVault.Cli\bin\Release\net10.0-windows10.0.19041.0\publish\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CliFiles)" DestinationFolder="$(OutDir)cli\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="AddCliToPublishOutput" BeforeTargets="ComputeFilesToPublish" Condition="'$(Configuration)' == 'Release' AND Exists('..\PasswordVault.Cli\bin\Release\net10.0-windows10.0.19041.0')">
    <ItemGroup>
      <CliFilesForPublish Include="..\PasswordVault.Cli\bin\Release\net10.0-windows10.0.19041.0\**\*.*"
                           Exclude="..\PasswordVault.Cli\bin\Release\net10.0-windows10.0.19041.0\publish\**\*.*" />
      <ResolvedFileToPublish Include="@(CliFilesForPublish)">
        <RelativePath>cli\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
    PasswordVault.NativeHost（瀏覽器擴充功能的 Native Messaging Host 轉接層）跟 CLI 不同，
    刻意複製到跟 PasswordVault.exe 同一層（不是子資料夾）——PasswordVaultNativePipeServer
    的 VerifyClientIsExpectedHost 安全檢查、App.xaml.cs 建構 Pipe Server 時都假設它位在
    AppContext.BaseDirectory 底下（見 App.xaml.cs、PasswordVaultNativePipeServer.cs 的既有
    路徑組法），這個假設要跟這裡的複製目的地保持一致，兩邊任何一邊改了路徑另一邊要跟著改。
    TargetFramework 是 net10.0（不含 -windows），跟 GUI/CLI 的 net10.0-windows... 不同，
    路徑要分開寫。
  -->
  <Target Name="BuildNativeHost" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="dotnet build ..\PasswordVault.NativeHost\PasswordVault.NativeHost.csproj -c Release" />
  </Target>

  <Target Name="CopyNativeHostForRelease" AfterTargets="BuildNativeHost" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <NativeHostFiles Include="..\PasswordVault.NativeHost\bin\Release\net10.0\**\*.*"
                        Exclude="..\PasswordVault.NativeHost\bin\Release\net10.0\publish\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeHostFiles)" DestinationFolder="$(OutDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="AddNativeHostToPublishOutput" BeforeTargets="ComputeFilesToPublish" Condition="'$(Configuration)' == 'Release' AND Exists('..\PasswordVault.NativeHost\bin\Release\net10.0')">
    <ItemGroup>
      <NativeHostFilesForPublish Include="..\PasswordVault.NativeHost\bin\Release\net10.0\**\*.*"
                                  Exclude="..\PasswordVault.NativeHost\bin\Release\net10.0\publish\**\*.*" />
      <ResolvedFileToPublish Include="@(NativeHostFilesForPublish)">
        <RelativePath>%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 密碼庫是可選配部件（見 FileLocker_密碼庫_功能規劃.md 第 2 節），編譯輸出獨立的
         FileLocker.PasswordLocker.dll，FileLocker.App 完全不在編譯期引用這個專案——只透過
         FileLocker.PluginContracts 定義的介面，在執行期用 AssemblyLoadContext 動態載入。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileLocker.Core\FileLocker.Core.csproj" />
    <ProjectReference Include="..\FileLocker.PluginContracts\FileLocker.PluginContracts.csproj" />
  </ItemGroup>

</Project>
